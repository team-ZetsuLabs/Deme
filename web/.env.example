# Copier en .env.local (ignoré par Git).
# mock : données d'exemple de src/mocks ; live : vraie API via le proxy /api.
VITE_API_MODE=mock

# Back-end visé par le proxy /api en mode live (npm run dev uniquement).
# Back-end déployé : https://hackathon-backend-pw2o.onrender.com
API_PROXY_TARGET=http://localhost:8080

# Délai simulé des réponses en mode mock, en millisecondes (1000 par défaut).
VITE_MOCK_DELAY_MS=1000

# Adresse de contact affichée sur les pages Règles, Conditions et Confidentialité.
# Laisser vide pour ne rien afficher.
VITE_CONTACT_EMAIL=
