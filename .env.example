# Mode de l'API : live (vrai back-end) ou mock (exemples de src/mocks)
VITE_API_MODE=live
# Back-end vers lequel le proxy de Vite renvoie /api en local
VITE_API_TARGET=http://localhost:8080
# Adresse du site public (bouton « Voir le site » et liens vers les contenus)
VITE_SITE_URL=https://hackathon-web-4glg.onrender.com/
# Contrat OpenAPI utilisé par npm run gen:api
VITE_API_SPEC=http://localhost:8080/api/v1/openapi.json
