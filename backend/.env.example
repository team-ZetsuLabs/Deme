# Copier en .env (ignoré par Git) et remplacer les valeurs factices.

# Profils : « local » sans HTTPS sur sa machine ; ajouter « oauth » quand les identifiants ci-dessous sont remplis.
SPRING_PROFILES_ACTIVE=local

DATABASE_URL=jdbc:postgresql://localhost:5432/zetsu
DATABASE_USER=zetsu
DATABASE_PASSWORD=change-moi

# Adresse du site web, où l'on revient après une connexion GitHub ou Google.
FRONT_URL=http://localhost:5173/
# true en production (HTTPS), false seulement en local.
COOKIE_SECURE=false

# Dossier des téléversements (photos, CV), jamais servi directement. Sert seulement sans Cloudinary.
UPLOADS_DIR=data/uploads

# Cloudinary (photos de profil et CV). Valeurs dans la console Cloudinary, rubrique « API Keys ».
# Vides, les fichiers restent dans UPLOADS_DIR. Le secret ne quitte jamais le serveur.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dossier racine chez Cloudinary (1 à 12 caractères : a-z, 0-9, _ et -), par exemple zetsu en production, zetsu-dev en local.
CLOUDINARY_FOLDER=zetsu

# OAuth (profil « oauth »)
GITHUB_CLIENT_ID=ton-client-id-github
GITHUB_CLIENT_SECRET=ton-secret-github
GOOGLE_CLIENT_ID=ton-client-id-google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton-secret-google

# Assistant IA (IA-1). Clé gratuite sur https://aistudio.google.com/apikey ; vide, l'assistant est coupé.
AI_PROVIDER=gemini
AI_API_KEY=ta-cle-gemini
AI_MODEL=gemini-2.5-flash-lite
